# =============================================================================
# Cryptika Relay Server - Environment Configuration Template
# =============================================================================
# Copy this file to .env before starting the server:
#   cp .env.example .env
#
# Generating Secure Random Keys:
# Each secret requires a secure 64-character (32-byte) hex string.
# Generate them using OpenSSL:
#   openssl rand -hex 32
#
# Run the command separately for each secret below so each variable receives
# a unique cryptographic key.
# =============================================================================

# Node environment mode (production or development)
NODE_ENV=production

# Server listening port
PORT=8443

# HMAC Secret Key (64-char hex / 32 bytes)
# Used for blind relay HMAC token authentication and integrity checks.
# Generate with: openssl rand -hex 32
HMAC_SECRET_HEX=

# JWT Secret Key (64-char hex / 32 bytes)
# Used for signing and verifying JSON Web Tokens for client sessions.
# Generate with: openssl rand -hex 32
JWT_SECRET_HEX=

# Server Ed25519 Private Key / Seed (64-char hex / 32 bytes)
# Used to persist the server's cryptographic identity across container restarts.
# When provided, the server derives its Ed25519 keypair deterministically.
# Generate with: openssl rand -hex 32
SERVER_PRIVATE_KEY_HEX=
